# Supabase Configuration (for Next.js app - public keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (ONLY for GitHub Actions - server-side only, never expose to frontend)
# Do not add this to .env.local - only use in GitHub Actions secrets
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CRON Secret (for snapshot trigger API)
# Used to protect GET/POST /api/snapshot/run endpoint
# Generate a strong random secret: openssl rand -hex 32
#
# LOCAL DEVELOPMENT:
# Add this to .env.local for testing manual triggers
#
# VERCEL DEPLOYMENT:
# 1. Go to Vercel Project Settings → Environment Variables
# 2. Add CRON_SECRET with the same value for Production, Preview, and Development
# 3. Vercel Cron (configured in vercel.json) will automatically use this secret
# 4. The cron job runs every 5 minutes: GET /api/snapshot/run?secret=$CRON_SECRET
CRON_SECRET=your-secret-key-here
