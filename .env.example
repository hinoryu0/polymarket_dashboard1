# Supabase Configuration (for Next.js app - public keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (ONLY for GitHub Actions - server-side only, never expose to frontend)
# Do not add this to .env.local - only use in GitHub Actions secrets
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CRON Secret (for manual snapshot trigger API)
# Used to protect POST /api/snapshot/run endpoint
# Generate a strong random secret (e.g., openssl rand -hex 32)
CRON_SECRET=your-secret-key-here
